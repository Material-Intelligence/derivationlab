# Needle list for tools/release_check.py — format documentation.
#
# Copy this file to `.release-needles` in your working copy and replace the
# synthetic entries below with the real ones. `.release-needles` is ignored by
# git (see .gitignore), the scanner never scans it, and the test suite asserts
# that git's publish set does not contain it.
#
# Why the split. Three of the scanner's gates work by substring: a private path
# or hostname (identifier), a provenance claim this snapshot does not make
# (provenance), and an institution or funding line (affiliation). Their needles
# are exactly the strings that must not appear in the public tree — so shipping
# the list would publish the very thing the gate exists to keep out. Encoding it
# would not help: an encoding is reversible by anyone who reads the decoder next
# to it. The list therefore lives outside the repository, and the published
# scanner carries no needle at all.
#
# Without `.release-needles` those three gates are OFF. The scanner says so on
# stderr and repeats it in its final line; it does not pretend to have checked.
# The gates that need no secret — secret patterns, generic high-entropy tokens,
# third-party email addresses, CJK characters, oversized files, committed
# bytecode, non-text files, and the identity check — always run.
#
# Format: sections in brackets, one entry per line; blank lines and lines
# starting with `#` are ignored. Entries are plain substrings, matched
# case-insensitively, never regular expressions. Surrounding whitespace is
# stripped; wrap an entry in double quotes to keep it ("acme " below matches the
# word, not every string that starts with those four letters).

[literals]
# Gate: identifier. Machine paths, private network names, unpublished
# identifiers, other people's account names.
/Users/nobody
/home/nobody
example-tailnet
10.9999/aaaa-bbbb
somebody-elses-account

[vocabulary]
# Gate: provenance. Claims about how this code was written that the snapshot
# does not make, and any tool name that would amount to one. The entries here
# are placeholders; a real list names the tools and the stock phrases that carry
# such a claim, including the ones a commit template inserts automatically.
acme-model-vendor
dictated-to-a-parrot
transcribed-from-a-dream

[affiliation]
# Gate: affiliation. Institutions, laboratories, clusters and funding lines.
imaginary institute of nowhere
"acme "
paid for by an anonymous benefactor
stipend no.

[allow]
# Narrow, deliberate exemptions: glob | gate | matched text | why.
# An exemption applies only to files matching the glob and only to that exact
# matched text, and the reason is part of the entry because an exemption with no
# stated reason is indistinguishable from a gate someone quietly turned off.
examples/runs/*/manifest.json | provenance | acme-model-vendor | a recorded runtime sidecar states which provider the run used; that is data about the run, not a claim about who wrote this code
